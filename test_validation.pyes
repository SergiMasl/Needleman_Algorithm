from validation import validate_dna_sequence, validate_int

print("---- DNA sequence tests ----")

test_sequences = [
    ("ACGT", "seq1"),
    ("acgt", "seq2"),
    ("A C G T", "seq3"),
    ("ACGTX", "bad_seq"),
    ("", "empty_seq"),
    (None, "none_seq"),
]

for seq, name in test_sequences:
    try:
        result = validate_dna_sequence(seq, name=name)
        print(f"{name}: PASS -> {result}")
    except ValueError as e:
        print(f"{name}: FAIL -> {e}")

print("\n---- Integer tests ----")

test_values = [
    (2, "match"),
    ("-1", "mismatch"),
    ("-2", "gap"),
    ("abc", "bad_value"),
    (None, "none_value"),
]

for value, name in test_values:
    try:
        result = validate_int(value, name=name)
        print(f"{name}: PASS -> {result}")
    except ValueError as e:
        print(f"{name}: FAIL -> {e}")
